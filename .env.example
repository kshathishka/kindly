# ---------------------------------------------------------------------------
# Kindly backend configuration. Copy to .env and fill in.
# Every name here maps to a field on Settings in app/config.py.
# ---------------------------------------------------------------------------

APP_TITLE=Kindly
APP_ENV=development

# Comma-separated list of origins allowed to call this API.
# The Next.js dev server runs on port 3000.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where the JSON files live, relative to the repository root.
JSON_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Story generation. Without a key the app still works: it falls back to the
# built-in template and marks the story source as "template".
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ENABLE_AI_GENERATION=true
FALLBACK_TO_TEMPLATE=true

LOG_LEVEL=INFO
